<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/javascripts/product/upload_Mediafile.js"></script>

</head>

<body class="p-5">
  <div class="container">
    <h2 class="mb-4">Upload MP3 & Image</h2>

    <!-- Progress Bar -->
    <div id="uploadProgressContainer" class="progress mb-3" style="height: 25px; display: none;">
      <div id="uploadProgressBar" class="progress-bar progress-bar-striped bg-info progress-bar-animated"
        role="progressbar" style="width: 0%;" aria-valuemin="0" aria-valuemax="100">0%</div>
    </div>

    <!-- Alert Messages -->
    <div id="alertContainer"></div>

    <!-- Upload Form -->
    <form id="uploadForm">
      <div class="mb-3">
        <label for="mp3Name" class="form-label">Name:</label>
        <input type="text" class="form-control" id="mp3Name" name="name" placeholder="Nhập tên bài hát (tùy chọn)">
      </div>

      <div class="mb-3">
        <label for="categoryId" class="form-label">Category:</label>
        <select class="form-select" id="categoryId" name="categoryId" required>
          <option value="">-- Chọn danh mục --</option>
          <% if (listidCategory && listidCategory.length > 0) { %>
            <% listidCategory.forEach(function(category) { %>
              <option value="<%= category._id %>"><%= category.nameCategory %></option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <div class="mb-3">
        <label for="mp3File" class="form-label">Select MP3 File:</label>
        <input type="file" class="form-control" id="mp3File" name="mp3File" accept=".mp3" required>
        <div class="form-text">Chỉ chấp nhận file MP3 (tối đa 50MB)</div>
      </div>

      <!-- Thêm phần upload ảnh -->
      <div class="mb-3">
        <label for="imageFile" class="form-label">Select Image (Optional):</label>
        <input type="file" class="form-control" id="imageFile" name="imageFile" accept="image/*">
        <div class="form-text">Chọn ảnh bìa cho bài hát (tùy chọn) - Ảnh sẽ được upload lên ImgBB</div>
      </div>

      <!-- Image Preview -->
      <div id="imagePreview" class="mb-3" style="display: none;">
        <label class="form-label">Preview:</label>
        <div class="border rounded p-2">
          <img id="previewImg" src="" alt="Preview" style="max-width: 200px; max-height: 200px; object-fit: cover;">
        </div>
      </div>

      <button type="submit" class="btn btn-primary" id="uploadBtn">
        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
        Upload
      </button>
      <button type="button" class="btn btn-secondary ms-2" id="backBtn">Quay lại</button>
    </form>
  </div>
</body>

</html>
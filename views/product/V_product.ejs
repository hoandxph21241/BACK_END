<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<% const uploadUser = typeof user !== 'undefined' ? user : null; const uploadOwner = uploadUser ? String(uploadUser._id || uploadUser.id || uploadUser.userID || '') : ''; %>
<link rel="stylesheet" href="/stylesheets/upload_notifications.css">
<script src="/javascripts/upload_notifications.js" defer data-notification-owner="<%= uploadUser ? (uploadUser.userID || uploadOwner) : 'guest' %>"></script>
<!-- The complete former batch view is preserved in _upload_batch_legacy.ejs; its JS remains unloaded. -->
<!-- Reuse selector/button/icon styles so the initial upload screen keeps its existing layout. -->
<link rel="stylesheet" href="/stylesheets/CSS_Products/upload_queue.css">
<link rel="stylesheet" href="/stylesheets/CSS_Products/upload_single.css">
<section class="upload-view upload-single-view" data-upload-view data-upload-owner="<%= uploadOwner %>" data-upload-step="select" data-upload-state="empty">
  <header class="upload-heading">
    <div class="upload-brand"><span class="upload-brand-logo"><img src="/images/bg.png" alt="" width="120" height="120"></span><h1>MediaHz Upload</h1></div>
    <a class="upload-icon-button upload-close" href="/discover" data-upload-link aria-label="Đóng trang tải lên" title="Đóng trang tải lên"><i class="upload-icon icon-close" aria-hidden="true"></i></a>
  </header>
  <form id="uploadForm" action="/product/upload" method="post" enctype="multipart/form-data" accept-charset="UTF-8" novalidate>
    <div id="uploadAlert" class="upload-alert" role="alert" hidden></div>
    <!-- Previously multiple; one picker and one pending audio are now supported. -->
    <input type="file" id="mp3File" accept=".mp3,.m4a,.wav,.flac,audio/mpeg,audio/mp4,audio/wav,audio/flac" hidden>
    <section id="uploadSelectStep" class="upload-select-step" aria-labelledby="uploadSelectTitle">
      <div class="upload-selection-limits"><span><i class="upload-icon icon-upload" aria-hidden="true"></i>Một bài hát mỗi lần tải lên</span><span>25 MB / tệp</span></div>
      <div class="upload-select-intro"><h2 id="uploadSelectTitle">Tải tệp âm thanh</h2><p>WAV · FLAC · MP3 · M4A</p></div>
      <div id="uploadDropzone" class="upload-dropzone" role="region" aria-label="Vùng nhận tệp âm thanh kéo thả">
        <i class="upload-icon icon-upload upload-drop-icon" aria-hidden="true"></i>
        <span class="upload-drop-formats" aria-hidden="true">WAV / FLAC / MP3 / M4A</span>
        <button class="upload-button upload-choose-button" id="uploadChooseFiles" type="button">Chọn tệp</button>
      </div>
      <div class="upload-select-links"><a class="upload-button upload-button-quiet" href="/product/update" data-upload-link><i class="upload-icon icon-edit" aria-hidden="true"></i>Quản lý bài hát</a></div>
    </section>
    <section id="uploadDetailsStep" class="upload-details-step" aria-labelledby="uploadDetailsTitle" hidden>
      <div class="upload-details-heading"><div><p class="upload-single-eyebrow">MEDIAHZ / UPLOAD</p><h2 id="uploadDetailsTitle" tabindex="-1">Thông tin bài hát</h2></div><span class="upload-single-caption">Một bài hát · Tối đa 25 MB</span></div>
      <section class="upload-single-progress" id="uploadProgressContainer" aria-label="Tiến trình tải lên">
        <div class="upload-single-status-line"><span id="uploadStatus" role="status">Chờ tải lên</span><output id="uploadPercent" aria-label="Phần trăm dữ liệu đã gửi">0%</output></div>
        <progress id="uploadProgressBar" value="0" max="100" aria-label="Dữ liệu đã gửi lên máy chủ"></progress>
        <div class="upload-single-transfer"><span id="uploadTransferSummary">Chưa bắt đầu truyền dữ liệu</span><span id="uploadTransferSpeed"></span><span id="uploadElapsed">00:00</span></div>
        <p id="uploadStatusHint" class="upload-single-caption" hidden></p>
      </section>
      <div class="upload-single-editor">
        <div class="upload-single-artwork-field">
          <button type="button" id="uploadArtwork" class="upload-single-artwork" aria-label="Chọn ảnh bìa"><img alt="Ảnh bìa xem trước" hidden><span class="upload-artwork-placeholder"><i class="upload-icon icon-image" aria-hidden="true"></i><strong>Thêm ảnh bìa</strong></span><span class="upload-artwork-change">Đổi ảnh bìa</span></button>
          <input type="file" id="uploadCoverFile" accept="image/jpeg,image/png,image/webp" hidden>
          <div class="upload-artwork-info"><span>JPG, PNG hoặc WebP · Tối đa 5 MB</span><button class="upload-text-button" id="uploadRemoveCover" type="button" hidden>Bỏ ảnh</button></div>
        </div>
        <div class="upload-single-fields">
          <label for="uploadTitle">Tên bài hát <span class="upload-required" aria-hidden="true">*</span><input id="uploadTitle" class="upload-single-input" name="name" type="text" maxlength="200" required autocomplete="off" placeholder="Nhập tên bài hát"></label>
          <label for="uploadArtist">Nghệ sĩ <span class="upload-optional">Không bắt buộc</span><input id="uploadArtist" class="upload-single-input" name="artist" type="text" maxlength="200" autocomplete="off" placeholder="Tên nghệ sĩ hoặc người thể hiện"></label>
          <label for="categoryId">Thể loại <span class="upload-optional">Không bắt buộc</span><select id="categoryId" name="categoryId"><option value="">Chưa phân loại</option><% (listidCategory || []).forEach(function(category) { %><option value="<%= category._id %>"><%= category.nameCategory %></option><% }); %></select></label>
          <p class="upload-single-caption">Bạn có thể bổ sung hoặc thay đổi thể loại sau khi tải lên.</p>
          <div class="upload-single-file"><i class="upload-icon icon-music" aria-hidden="true"></i><div><span id="uploadFilename"></span><span id="uploadFileSize" class="upload-single-caption"></span></div><button type="button" id="uploadReplace" class="upload-text-button">Đổi tệp</button></div>
        </div>
      </div>
      <footer class="upload-footer upload-single-footer">
        <button class="upload-button upload-button-quiet" id="uploadReset" type="button"><i class="upload-icon icon-back" aria-hidden="true"></i><span>Chọn tệp khác</span></button>
        <span class="upload-footer-spacer"></span>
        <a class="upload-button upload-button-quiet" id="uploadLibraryLink" href="/library" data-upload-link hidden>Kiểm tra Library</a>
        <a class="upload-button upload-button-quiet" id="uploadSongLink" href="/library" data-upload-link hidden>Xem bài hát</a>
        <button class="upload-button upload-button-primary" id="uploadBtn" type="submit" disabled><i class="upload-icon icon-upload" aria-hidden="true"></i><span>Tải lên</span></button>
      </footer>
    </section>
  </form>
</section>
<script src="/javascripts/product/upload_single.js" defer></script>
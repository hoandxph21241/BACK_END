<!-- Header -->
<style>
    body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background-color: #2e2d2d;
    }

    .background_nav {
        width: 100%;
        height: 50px;
        background-color: rgb(0, 0, 0);
        display: flex;
        align-items: center;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
        position: relative;
        z-index: 1000;
    }

    .nav-logo img {
        height: 80px;
        width: auto;
    }

    .nav-main {
        display: flex;
        align-items: center;
        height: 100%;
        width: 82%;
        margin: 0 auto;     
        padding: 0 15px;  
    }

    .nav-main .nav-item {
        height: 100%;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .nav-main .nav-item .btn,
    .nav-main .nav-item a {
        height: 100%;
        padding: 0 15px;
        border: none;
        border-radius: 0;
        background: transparent;
        color: #999;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        width: 100%;
    }

    .nav-main .nav-item button,
    .nav-main .nav-item .nav-link {
        height: 100%;
        width: 100%;
        display: flex;
        align-items: center;
    }

    .nav-main .nav-item .btn:hover {
        color: #ffffff;
    }

    .nav-main .nav-item .btn.active {
        color: #ffffff;
    }

    .nav-main .nav-item .btn svg {
        margin-right: 5px;
    }

    .nav-search {
        flex: 1;
        margin: 0 10px;
    }

    .nav-search .btn-find svg {
        fill: #ffffff;
    }

    .nav-user {
        display: flex;
        align-items: center;
        margin-left: auto;
        height: 100%;
    }

    .nav-user .nav-item {
        height: 100%;
    }

    .nav-user .nav-item div,
    .nav-user .nav-item a {
        height: 100%;
        display: flex;
        align-items: center;
    }

    .nav-item {
        position: relative;
    }

    .nav-item:hover .btn,
    .nav-item:hover a {
        color: #ffffff;
    }

    .dropdown-menu {
        margin-top: 0;
        border-radius: 2px;
        background-color: #333;
        border: 1px solid #404040;
    }

    .dropdown-menu .dropdown-item {
        color: #999;
        font-size: 14px;
        padding: 8px 20px;
    }

    .dropdown-menu .dropdown-item:hover {
        background-color: #404040;
        color: #fff;
    }

    .dropdown-menu .dropdown-divider {
        border-top: 1px solid #404040;
        margin: 4px 0;
    }

    .nav-user .dropdown-menu {
        right: 0;
        left: auto;
    }
</style>

<body>
    <div class="container-fluid p-0">
        <div class="row m-0">
            <!-- Sidebar -->
            <nav class="background_nav d-md-block sidebar custom-sidebar">
                <!-- Main Navigation -->
                <div class="nav-main">
                    <ul class="nav d-flex align-items-center mb-0">

                        <li class="nav-logo">
                            <a href="/home">
                                <img src="/images/bg.png" alt="Logo Icon" title="Back To Home" />
                            </a>
                        </li>

                        <!-- Home Icon -->
                        <li class="nav-item">
                            <a href="/home/pratical" class="btn nav-link d-inline" data-url="/home/pratical">
                                <samp class="fw-bold">
                                    Home
                                </samp>
                            </a>
                        </li>

                        <!-- Feed Icon -->
                        <li class="nav-item">
                            <a href="/home/ct_home_v2" class="btn nav-link d-inline" data-url="/home/ct_home_v2">
                                <samp class="fw-bold">
                                    Feed
                                </samp>
                            </a>
                        </li>

                        <!--Library  Icon -->
                        <li class="nav-item">
                            <a href="/home/ct_home" class="btn nav-link d-inline" data-url="/home/ct_home">
                                <samp class="fw-bold">
                                    Library
                                </samp>
                            </a>
                        </li>
                    </ul>

                    <!-- Search Bar -->
                    <div class="nav-search">
                        <form class="d-flex" role="search">
                            <input class="form-control" type="search" placeholder="Search" aria-label="Search">
                            <button class="btn btn-find" type="submit">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                    class="bi bi-search" viewBox="0 0 16 16">
                                    <path
                                        d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                                </svg>
                            </button>
                        </form>
                    </div>

                    <!-- User Navigation -->
                    <div class="nav-user">
                        <!-- User Icon with Dropdown -->
                        <li class="nav-item p-2 dropdown">
                            <div class="text-center">
                                <button type="button" class="btn btn-outline-warning dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                        fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                                        <path fill-rule="evenodd"
                                            d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
                                    </svg>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item nav-link d-inline p-0" href="/users/profile" data-url="/users/profile">Profile</a></li>
                                    <li><a class="dropdown-item nav-link d-inline p-0" href="/users/likes" data-url="/users/likes">Likes</a></li>
                                    <li><a class="dropdown-item nav-link d-inline p-0" href="/users/playlists" data-url="/users/playlists">Playlists</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item nav-link d-inline p-0" href="/users/settings" data-url="/users/settings">Settings</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item nav-link d-inline p-0" href="/auth/signout" data-url="/auth/signout">Sign out</a></li>
                                </ul>
                            </div>
                        </li>


                        <li class="nav-item p-2">
                            <div class="text-center">
                                <a href="" class="nav-link d-inline p-0" data-url="">
                                    <button type="button" class="btn btn-outline-primary">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                            fill="currentColor" class="bi bi-cloud-arrow-up-fill" viewBox="0 0 16 16">
                                            <path
                                                d="M8 2a5.53 5.53 0 0 0-3.594 1.342c-.766.66-1.321 1.52-1.464 2.383C1.266 6.095 0 7.555 0 9.318 0 11.366 1.708 13 3.781 13h8.906C14.502 13 16 11.57 16 9.773c0-1.636-1.242-2.969-2.834-3.194C12.923 3.999 10.69 2 8 2m2.354 5.146a.5.5 0 0 1-.708.708L8.5 6.707V10.5a.5.5 0 0 1-1 0V6.707L6.354 7.854a.5.5 0 1 1-.708-.708l2-2a.5.5 0 0 1 .708 0z" />
                                        </svg>
                                    </button>
                                </a>
                            </div>
                        </li>

                        </ul>
                    </div>

                    <!-- Notification Icon -->
                    <button type="button" id="notification" class="me-3 btn btn-outline-warning"
                        style="border: none; background-color: transparent">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                            class="bi bi-bell-fill" viewBox="0 0 16 16">
                            <path
                                d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2m.995-14.901a1 1 0 1 0-1.99 0A5 5 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901" />
                        </svg>
                    </button>

                    <!-- Mail Icon -->
                    <button type="button" id="Mail" class="me-3 btn btn-outline-warning"
                        style="border: none; background-color: transparent">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                            class="bi bi-envelope-fill" viewBox="0 0 16 16">
                            <path
                                d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.104l5.803-3.558zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586zm3.436-.586L16 11.801V4.697z" />
                        </svg>
                    </button>
            </nav>
        </div>
    </div>
</body>
        // Volume popup lives outside the short player iframe.
        let volumePopupTimeout;
        let volumePopupHovered = false;
        let volumePopupFocused = false;
        const volumePopup = document.getElementById('parentVolumePopup');
        const volumeSlider = document.getElementById('parentVolumeSlider');
        const volumeValue = volumePopup.querySelector('.volume-value');

        function updateVolumePopup(value) {
          const volume = Math.max(0, Math.min(100, Number(value) || 0));
          volumeSlider.value = volume;
          volumeSlider.style.setProperty('--volume-progress', `${volume}%`);
          volumeSlider.setAttribute('aria-valuetext', `${Math.round(volume)}%`);
          volumeValue.textContent = Math.round(volume) + '%';
        }

        function closeVolumePopup() {
          clearTimeout(volumePopupTimeout);
          volumePopup.classList.remove('show');
          // volumePopup.style.display = 'none';
        }

        function showVolumePopup(volume, buttonRect) {
          clearTimeout(volumePopupTimeout);
          updateVolumePopup(volume);
          const iframe = document.getElementById('mediaPlayerFrame');
          if (!iframe || !buttonRect) return;
          const rect = iframe.getBoundingClientRect();
          volumePopup.style.display = 'flex';
          volumePopup.classList.add('show');
          const width = volumePopup.offsetWidth;
          const height = volumePopup.offsetHeight;
          const center = rect.left + (buttonRect.left + buttonRect.right) / 2;
          volumePopup.style.left = `${Math.max(4, Math.min(window.innerWidth - width - 4, center - width / 2))}px`;
          volumePopup.style.top = `${Math.max(4, rect.top + buttonRect.top - height - 8)}px`;
        }

        function hideVolumePopup() {
          clearTimeout(volumePopupTimeout);
          volumePopupTimeout = setTimeout(() => {
            if (volumePopupHovered || volumePopupFocused) return;
            document.getElementById('mediaPlayerFrame')?.contentWindow.postMessage({
              type: 'checkVolumeHover'
            }, window.location.origin);
          }, 220);
        }

        volumePopup.addEventListener('mouseenter', () => {
          volumePopupHovered = true;
          clearTimeout(volumePopupTimeout);
        });
        volumePopup.addEventListener('mouseleave', () => {
          volumePopupHovered = false;
          hideVolumePopup();
        });
        volumePopup.addEventListener('focusin', () => {
          volumePopupFocused = true;
          clearTimeout(volumePopupTimeout);
        });
        volumePopup.addEventListener('focusout', () => {
          volumePopupFocused = false;
          hideVolumePopup();
        });
        volumePopup.addEventListener('keydown', event => {
          if (event.key === 'Escape') {
            volumeSlider.blur();
            closeVolumePopup();
          }
        });
        volumeSlider.addEventListener('input', () => {
          const value = Number(volumeSlider.value);
          updateVolumePopup(value);
          document.getElementById('mediaPlayerFrame')?.contentWindow.postMessage({
            type: 'setVolume', value
          }, window.location.origin);
        });
        window.addEventListener('resize', closeVolumePopup);


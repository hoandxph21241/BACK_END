          if (networkFrame && networkFrame.contentWindow) {
            networkFrame.contentWindow.postMessage({
              type: 'networkStatus',
              isOnline: true,
              message: 'Mạng đã được kết nối!'
            }, '*');
          }
        });

        window.addEventListener('offline', () => {
          console.log('Network disconnected');
          const networkFrame = document.getElementById('networkPopupFrame');
          if (networkFrame && networkFrame.contentWindow) {
            networkFrame.contentWindow.postMessage({
              type: 'networkStatus',
              isOnline: false,
              message: 'Mất kết nối mạng!'
            }, '*');
          }
        });

        // ===== KEYBOARD SHORTCUTS FOR MEDIA CONTROL =====
        document.addEventListener('keydown', (event) => {
          const iframe = document.getElementById('mediaPlayerFrame');
          if (!iframe || !iframe.contentWindow) {
            console.warn('mediaPlayerFrame not found');
            return;
          }

          // Ignore if user is typing in input/textarea
          // if (event.target.tagName === 'INPUT' || event.target.tagName === 'TEXTAREA') {
          if (event.target.closest('input, textarea, select, button, [contenteditable]')) {
            return;
          }

          let handled = false;

          // Space: Play/Pause
          if (event.code === 'Space') {
            event.preventDefault();
            iframe.contentWindow.postMessage({
              type: 'keyboardControl',
              action: 'togglePlayPause'
            }, '*');
            console.log('[Keyboard] Space pressed → togglePlayPause');
            handled = true;
          }
          // Arrow Right: Next song or seek forward
          else if (event.code === 'ArrowRight') {
            event.preventDefault();
            if (event.ctrlKey) {
              // Ctrl+Right: Next song
              iframe.contentWindow.postMessage({
                type: 'keyboardControl',
                action: 'nextSong'
              }, '*');
              console.log('[Keyboard] Ctrl+Right pressed → nextSong');
            } else {
              // Right arrow: Seek forward 5 seconds
              iframe.contentWindow.postMessage({
                type: 'keyboardControl',
                action: 'seekForward',
                seconds: 5
              }, '*');
              console.log('[Keyboard] Right pressed → seekForward 5s');
            }
            handled = true;
          }
          // Arrow Left: Previous song or seek backward
          else if (event.code === 'ArrowLeft') {
            event.preventDefault();
            if (event.ctrlKey) {
              // Ctrl+Left: Previous song
              iframe.contentWindow.postMessage({
                type: 'keyboardControl',
                action: 'prevSong'
              }, '*');
              console.log('[Keyboard] Ctrl+Left pressed → prevSong');
            } else {
              // Left arrow: Seek backward 5 seconds
              iframe.contentWindow.postMessage({
                type: 'keyboardControl',
                action: 'seekBackward',
                seconds: 5
              }, '*');
              console.log('[Keyboard] Left pressed → seekBackward 5s');
            }
            handled = true;
          }
          // M: Mute toggle
          else if (event.code === 'KeyM') {
            event.preventDefault();
            iframe.contentWindow.postMessage({
              type: 'keyboardControl',
              action: 'toggleMute'
            }, '*');
            console.log('[Keyboard] M pressed → toggleMute');
            handled = true;
          }
          // Arrow Up: Volume up
          else if (event.code === 'ArrowUp') {
            event.preventDefault();
            iframe.contentWindow.postMessage({
              type: 'keyboardControl',
              action: 'volumeUp',
              amount: 10
            }, '*');
            console.log('[Keyboard] Up pressed → volumeUp');
            handled = true;
          }
          // Arrow Down: Volume down
          else if (event.code === 'ArrowDown') {
            event.preventDefault();
            iframe.contentWindow.postMessage({
              type: 'keyboardControl',
              action: 'volumeDown',
              amount: 10
            }, '*');
            console.log('[Keyboard] Down pressed → volumeDown');
            handled = true;
          }

          if (handled) {
            console.log('[Keyboard] Shortcut handled');
          }
        });

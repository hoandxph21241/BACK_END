      <script>
        axios.defaults.timeout = 10000;
        axios.defaults.headers.common['X-Requested-With'] = 'XMLHttpRequest';
        axios.interceptors.response.use(
          response => response,
          error => {
            if (error.response?.status === 401) {
              console.warn('Unauthorized access - consider redirecting to login');
            }
            return Promise.reject(error);
          }
        );

        window.playHistoryAPI = {
          async playSong(songId) {
            try {
              const response = await axios.post('/home/play-song', {
                songId: songId
              });
              const data = response.data;
              if (data.success) {
                console.log('Song added to history:', data.song);
                this.updateSidebarHistory();
                return data;
              } else {
                console.error('Error:', data.error);
                return null;
              }
            } catch (error) {
              console.error('Network error:', error.response?.data || error.message);
              return null;
            }
          },

          async loadPlayHistory(limit = 4) {
            try {
              const response = await axios.get('/home/play-history', {
                params: { limit: limit }
              });

              const data = response.data;

              if (data.success) {
                return data.historySongs;
              }
              return [];
            } catch (error) {
              console.error('Error loading history:', error.response?.data || error.message);
              return [];
            }
          },

          async clearPlayHistory() {
            try {
              const response = await axios.delete('/home/play-history');
              const data = response.data;

              if (data.success) {
                console.log('History cleared');
                this.updateSidebarHistory();
                return true;
              }
              return false;
            } catch (error) {
              console.error('Error clearing history:', error.response?.data || error.message);
              return false;
            }
          },

          async removeFromHistory(songId) {
            try {
              const response = await axios.delete(`/home/play-history/${songId}`);
              const data = response.data;

              if (data.success) {
                console.log('Song removed from history');
                this.updateSidebarHistory();
                return data.historySongs;
              }
              return null;
            } catch (error) {
              console.error('Error removing from history:', error.response?.data || error.message);
              return null;
            }
          },

          async updateSidebarHistory() {
            const historySection = document.querySelector('.history-section');
            if (historySection) {
              const historySongs = await this.loadPlayHistory(4);
              this.renderHistoryUI(historySongs, historySection);
            }
          },

          renderHistoryUI(historySongs, container) {
            const existingList = container.querySelector('.song-history');
            const existingMsg = container.querySelector('.no-history-msg');

            if (historySongs && historySongs.length > 0) {
              if (existingMsg) existingMsg.remove();

              let historyList = existingList;
              if (!historyList) {
                historyList = document.createElement('ul');
                historyList.className = 'song-history';
                container.appendChild(historyList);
              }

              historyList.innerHTML = historySongs.slice(0, 4).map(song => `
                <li class="history-item">
                  <div class="song-info">
                    <span class="song-title">${song.name}</span>
                    <small class="played-time">${song.playedAtRelative || 'Just now'}</small>
                  </div>
                  <button class="remove-btn" onclick="window.playHistoryAPI.removeFromHistory('${song.songId}')" title="Remove">
                    <i class="fas fa-times"></i>
                  </button>
                </li>
              `).join('');
            } else {
              if (existingList) existingList.remove();

              if (!existingMsg) {
                const noHistoryMsg = document.createElement('p');
                noHistoryMsg.className = 'no-history-msg';
                noHistoryMsg.style.cssText = 'color: #6c757d; font-size: 0.85rem; margin: 0;';
                noHistoryMsg.textContent = 'No recent plays';
                container.appendChild(noHistoryMsg);
              }
            }
          }
        };

        // Handle song click
        function handleSongClick(mp3Id, mp3Name, categoryId) {
          // Send to iframe media player
          const iframe = document.getElementById('mediaPlayerFrame');
          if (iframe && iframe.contentWindow) {
            iframe.contentWindow.postMessage(
              { mp3Id, mp3Name, categoryId },
              '*'
            );
          }

          // Add to play history
          window.playHistoryAPI.playSong(mp3Id);
        }

        // Initialize dynamic content
        function initializeDynamicContent() {
          if (document.getElementById('uploadForm')) {
            if (!window._uploadFormInitialized) {
              if (typeof window.initUploadForm !== 'function') {
                const script = document.createElement('script');
                script.src = '/javascripts/product/upload_Mediafile.js';
                script.onload = () => {
                  if (typeof window.initUploadForm === 'function') {
                    window.initUploadForm();
                  }
                };
                document.body.appendChild(script);
              } else {
                window.initUploadForm();
              }
            }
          }

          setTimeout(() => {
            window.playHistoryAPI.updateSidebarHistory();
          }, 200);
        }

        // Event listeners for static content
        document.querySelectorAll('.song-item').forEach(item => {
          item.addEventListener('click', () => {
            const mp3Id = item.dataset.id;
            const mp3Name = item.dataset.name;
            const categoryId = item.dataset.category;

            handleSongClick(mp3Id, mp3Name, categoryId);
          });
        });

        // Event delegation for dynamic content
        document.getElementById('main').addEventListener('click', function (event) {
          let target = event.target;
          while (target && !target.classList.contains('song-item')) {
            target = target.parentElement;
          }
          if (target && target.classList.contains('song-item')) {
            const mp3Id = target.dataset.id;
            const mp3Name = target.dataset.name;
            const categoryId = target.dataset.category;

            handleSongClick(mp3Id, mp3Name, categoryId);
          }
        });


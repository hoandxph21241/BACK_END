        let pendingPageKey = null;
        let displayedPageKey = null;
        let navigationController = null;
        function navigationKey(url) {
          const target = new URL(url, location.href);
          return tabPath(target.pathname.replace(/\/+$/, '') || '/') + target.search;
        }
        function waitForProfileImages(content, signal) {
          const template = document.createElement('template');
          template.innerHTML = content;
          const sources = [...new Set(Array.from(template.content.querySelectorAll('#profileBanner, #profileAvatar'),
            image => image.getAttribute('src')).filter(Boolean))];
          if (!sources.length || signal.aborted) return Promise.resolve();
          return new Promise(resolve => {
            const images = [];
            let remaining = sources.length;
            const finish = () => {
              clearTimeout(timeout);
              signal.removeEventListener('abort', finish);
              images.forEach(image => { image.onload = image.onerror = null; });
              resolve();
            };
            // A slow external avatar must not hold the profile indefinitely.
            const timeout = setTimeout(finish, 1200);
            signal.addEventListener('abort', finish, { once: true });
            sources.forEach(source => {
              const image = new Image();
              images.push(image);
              image.onload = image.onerror = () => { if (--remaining === 0) finish(); };
              image.src = source;
            });
          });
        }
        // Previous: async function loadPage(url, pushHistory = false) {
        async function loadPage(url, pushHistory = false, options = {}) {
          const destination = new URL(url, location.href);
          if (destination.origin !== location.origin) return;
          const pageKey = navigationKey(destination.href);
          // Previous: if (pendingPageKey === pageKey || (!pendingPageKey && displayedPageKey === pageKey)) return;
          if (pendingPageKey === pageKey || (!options.refresh && !pendingPageKey && displayedPageKey === pageKey)) return;
          const targetUrl = destination.pathname + destination.search + destination.hash;
          const request = ++navigationRequest;
          navigationController?.abort();
          const controller = new AbortController();
          navigationController = controller;
          pendingPageKey = pageKey;
          displayedPageKey = null;
          main.setAttribute('aria-busy', 'true');
          // Previous: main.innerHTML = '<div class="text-center text-light p-4" role="status">Loading...</div>';
          const libraryLoading = destination.pathname.replace(/\/+$/, '') === '/home/ct_home'
            ? document.getElementById('libraryLoadingTemplate') : null;
          const profileLoading = /^\/users\/profile(?:\/edit)?\/?$/.test(destination.pathname)
            ? document.getElementById('profileLoadingTemplate') : null;
          const previousLibrary = main.querySelector('.library-view:not(.library-skeleton)');
          const previousProfile = main.querySelector('[data-profile-view]');
          main.classList.toggle('library-page-active', Boolean(libraryLoading));
          main.classList.toggle('profile-page-active', Boolean(profileLoading));
          // Preserve scroll height on refresh; the next non-Library tab releases it.
          // Previous: main.style.minHeight = libraryLoading
          //   ? Math.ceil(Math.max(previousLibrary ? main.getBoundingClientRect().height : 0,
          //       window.innerHeight - main.getBoundingClientRect().top)) + 'px' : '';
          main.style.minHeight = libraryLoading || profileLoading
            ? Math.ceil(Math.max((libraryLoading ? previousLibrary : previousProfile) ? main.getBoundingClientRect().height : 0,
                window.innerHeight - main.getBoundingClientRect().top)) + 'px' : '';
          // Previous: main.innerHTML = libraryLoading?.innerHTML || '<div class="text-center text-light p-4" role="status">Loading...</div>';
          main.innerHTML = (profileLoading || libraryLoading)?.innerHTML || '<div class="text-center text-light p-4" role="status">Loading...</div>';
          const loadingStartedAt = Date.now();
          function commitPage(content) {
            main.innerHTML = content;
            if (libraryLoading) main.querySelector('.library-view')?.classList.add('library-content-ready');
            if (profileLoading) main.querySelector('[data-profile-view]')?.classList.add('profile-content-ready');
            displayedPageKey = pageKey;
            if (pushHistory && navigationKey(location.href) !== pageKey) {
              history.pushState({ url: targetUrl }, '', targetUrl);
            }
            updateActiveTab(destination.pathname);
          }
          try {
            const response = await axios.get(pageKey, {
              // Previous: headers: { 'X-Requested-With': 'XMLHttpRequest' },
              headers: { 'X-Requested-With': 'XMLHttpRequest', 'Cache-Control': 'no-cache' },
              signal: controller.signal,
            });
            if (request !== navigationRequest) return;
            if (libraryLoading) {
              const remaining = 1500 - (Date.now() - loadingStartedAt);
              if (remaining > 0) await new Promise(resolve => setTimeout(resolve, remaining));
            }
            if (profileLoading) await waitForProfileImages(response.data, controller.signal);
            if (request !== navigationRequest || controller.signal.aborted) return;
            commitPage(response.data);
            initializeDynamicContent();
          } catch (error) {
            if (request !== navigationRequest || controller.signal.aborted) return;
            if (error.response?.status === 404 && destination.pathname.startsWith('/home/song/') &&
                typeof error.response.data === 'string' && error.response.data.includes('track-missing')) {
              commitPage(error.response.data);
              return;
            }
            displayedPageKey = null;
            console.error('Cannot load tab:', error.message);
            main.innerHTML = '<div class="text-center text-light p-4"><p>Không thể tải trang.</p><button type="button" id="retryTabBtn" class="btn btn-outline-light">Thử lại</button></div>';
            document.getElementById('retryTabBtn').addEventListener('click', () => loadPage(targetUrl, pushHistory));
          } finally {
            if (request === navigationRequest) {
              pendingPageKey = null;
              navigationController = null;
              main.removeAttribute('aria-busy');
            }
          }
        }
        // Previous per-link bindings did not include account links inserted after popup login:

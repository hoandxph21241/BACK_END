<link rel="stylesheet" href="/stylesheets/home/music-card.css">
<link rel="stylesheet" href="/stylesheets/home/feed.css">
<link rel="stylesheet" href="/stylesheets/home/library.css">
<!-- <link rel="stylesheet" href="/stylesheets/fonts.css"> -->
<%
  const librarySongs = Array.isArray(mp3List) ? mp3List : [];
  const libraryCategories = songsByCategory || {};
%>
<section class="library-view feed-view" aria-label="Library">
  <main class="library-content">
    <header class="library-heading">
      <h1>Library</h1>
      <!-- <span id="libraryResultCount" aria-live="polite">&lt;%= librarySongs.length %> bài hát</span> -->
    </header>
    <div class="library-toolbar">
      <label class="library-search">
        <i class="fas fa-search" aria-hidden="true"></i>
        <input id="librarySearch" type="search" placeholder="Tìm bài hát, nghệ sĩ" aria-label="Tìm bài hát hoặc nghệ sĩ">
      </label>
      <select id="libraryCategory" aria-label="Lọc thể loại">
        <option value="">Tất cả thể loại</option>
        <% Object.entries(libraryCategories).forEach(([id, category]) => { %>
          <option value="<%= id %>"><%= category.name %></option>
        <% }); %>
      </select>
      <select id="librarySort" aria-label="Sắp xếp bài hát">
        <option value="recent">Mới nhất</option>
        <option value="title">Tên bài A–Z</option>
        <option value="artist">Nghệ sĩ A–Z</option>
      </select>
    </div>
    <div class="library-grid" id="libraryGrid">
      <% librarySongs.forEach((song, index) => { %>
        <div class="library-entry" data-order="<%= index %>"
             data-title="<%= song.name || song.title || '' %>"
             data-artist="<%= song.artist || '' %>"
             data-category="<%= song.categoryId?._id || song.categoryId || '' %>">
          <%- include('_feed_song_item', { song }) %>
        </div>
      <% }); %>
    </div>
    <div id="libraryEmpty" class="library-empty" <%= librarySongs.length ? 'hidden' : '' %>>
      <i class="fas fa-music" aria-hidden="true"></i>
      <p><%= librarySongs.length ? 'Không tìm thấy bài hát phù hợp.' : 'Chưa có bài hát trong thư viện.' %></p>
    </div>
  </main>
  <aside class="library-tools" aria-label="Công cụ thư viện">
    <h2>Công cụ</h2>
    <div class="library-tool-slots" aria-hidden="true">
      <div class="library-tool-slot"></div>
      <div class="library-tool-slot"></div>
      <div class="library-tool-slot library-tool-slot-wide"></div>
    </div>
  </aside>
</section>
<!-- Previous Library template retained for reference:

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link rel='stylesheet' href='/stylesheets/home/music-card.css' />

<body>

  <div class="main-layout">
      <p class="text-capitalize text-center fs-7 font-monospace fw-bold">Library</p>
    &lt;!-- Main Content Area --&gt;
    <div class="content-area">
      &lt;%
      // Sử dụng dữ liệu từ controller hoặc tạo fallback
      const displayTopRated = topRatedSongs || (mp3List ? mp3List.slice(0, 5) : []);
      const displayCategories = songsByCategory || {};
      %>

      &lt;% if (mp3List && mp3List.length > 0) { %>
        &lt;!-- Top Rated Section --&gt;
        <div class="section">
          <div class="section-header">
            <h2 class="section-title">
              <i class="fas fa-star top-rated-icon"></i>
              Top Rated
            </h2>
            <a href="/top-rated" class="view-all-btn">
              View All <i class="fas fa-arrow-right"></i>
            </a>
          </div>

          <div class="scroll-container">
            &lt;% displayTopRated.forEach(song => { %>
              <div class="music-card song-item"
                   data-id="&lt;%= song._id %>"
                   data-name="&lt;%= song.name %>"
                   data-category="&lt;%= song.categoryId ? song.categoryId._id : '' %>">
                <div class="music-thumbnail">
                  &lt;% if (song.image && song.image.url) { %>
                    <img src="&lt;%= song.image.url %>" alt="&lt;%= song.name %>">
                  &lt;% } else { %>
                    <i class="fas fa-music"></i>
                  &lt;% } %>
                </div>

                <div class="music-info">
                  <div class="music-title" title="&lt;%= song.name %>">
                    &lt;%= song.name %>
                  </div>
                  <div class="music-category">
                    <i class="fas fa-tag"></i>
                    &lt;%= song.categoryId ? song.categoryId.nameCategory : 'Unknown' %>
                  </div>
                </div>
              </div>
            &lt;% }); %>
          </div>
        </div>

        &lt;!-- Categories Sections --&gt;
        &lt;% Object.keys(displayCategories).forEach((categoryId) => {
           const categoryData = displayCategories[categoryId];
           if (categoryData.songs && categoryData.songs.length > 0) { %>

          <div class="section">
            <div class="section-header">
              <h2 class="section-title">
                <i class="fas fa-music category-icon"></i>
                &lt;%= categoryData.name %>
              </h2>
              <a href="/category/&lt;%= categoryId %>" class="view-all-btn">
                View All <i class="fas fa-arrow-right"></i>
              </a>
            </div>

            <div class="scroll-container">
              &lt;% categoryData.songs.forEach(song => { %>
                <div class="music-card song-item"
                     data-id="&lt;%= song._id %>"
                     data-name="&lt;%= song.name %>"
                     data-category="&lt;%= song.categoryId._id %>">
                  <div class="music-thumbnail">
                    &lt;% if (song.image && song.image.url) { %>
                      <img src="&lt;%= song.image.url %>" alt="&lt;%= song.name %>">
                    &lt;% } else { %>
                      <i class="fas fa-music"></i>
                    &lt;% } %>
                  </div>
                  <div class="music-info">
                    <div class="music-title" title="&lt;%= song.name %>">
                      &lt;%= song.name %>
                    </div>
                    <div class="music-category">
                      <i class="fas fa-tag"></i>
                      &lt;%= categoryData.name %>
                    </div>
                  </div>
                </div>
              &lt;% }); %>
            </div>
          </div>
        &lt;% } }); %>

      &lt;% } else { %>
        <div class="empty-state">
          <i class="fas fa-music"></i>
          <h3>No Music Found</h3>
          <p>There are no songs available at the moment.</p>
          <a href="/product" class="btn btn-primary">
            <i class="fas fa-plus"></i> Upload Music
          </a>
        </div>
      &lt;% } %>
    </div>

    <div class="sidebar-area">
      <div class="greeting">
        <h5>Hey, &lt;%= user.fullName || 'Guest' %> 👋</h5>
        <p>How are you today?</p>
      </div>

      <div class="history-section">
        <h6>
          <i class="fas fa-history"></i>
          Recently Played
        </h6>
        &lt;% if (historySongs && historySongs.length > 0) { %>
          <ul class="song-history">
            &lt;% historySongs.slice(0, 4).forEach(song => { %>
              <li>
                <span class="song-title">&lt;%= song.name %></span>
                <small class="played-time">&lt;%= song.playedAtRelative || 'Just now' %></small>
              </li>
            &lt;% }) %>
          </ul>
        &lt;% } else { %>
          <p style="color: #6c757d; font-size: 0.85rem; margin: 0;">No recent plays</p>
        &lt;% } %>
      </div>

      <div class="language-section">
        <label for="langSelect">
          <i class="fas fa-globe"></i> Language
        </label>
        <select id="langSelect">
          <option value="en">English</option>
          <option value="vi">Tiếng Việt</option>
          <option value="ja">日本語</option>
        </select>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    document.querySelectorAll('.scroll-container').forEach(container => {
      let isDown = false;
      let startX;
      let scrollLeft;

      container.addEventListener('mousedown', (e) => {
        isDown = true;
        container.style.cursor = 'grabbing';
        startX = e.pageX - container.offsetLeft;
        scrollLeft = container.scrollLeft;
      });

      container.addEventListener('mouseleave', () => {
        isDown = false;
        container.style.cursor = 'grab';
      });

      container.addEventListener('mouseup', () => {
        isDown = false;
        container.style.cursor = 'grab';
      });

      container.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - container.offsetLeft;
        const walk = (x - startX) * 2;
        container.scrollLeft = scrollLeft - walk;
      });
    });
    document.querySelectorAll('.song-item').forEach(item => {
      item.addEventListener('click', function(e) {
        e.preventDefault();

        const mp3Id = this.dataset.id;
        const mp3Name = this.dataset.name;
        const categoryId = this.dataset.category;

        this.style.transform = 'scale(0.95)';
        setTimeout(() => {
          this.style.transform = '';
        }, 150);

        if (window.parent && window.parent !== window) {
          window.parent.postMessage({
            type: 'songSelected',
            mp3Id,
            mp3Name,
            categoryId
          }, '*');
        }

        console.log('Song selected:', { mp3Id, mp3Name, categoryId });
      });
    });

    document.getElementById('langSelect').addEventListener('change', function(e) {
      console.log('Language changed to:', e.target.value);
    });
  </script>
</body>
</html>
-->

<dialog id="accountInfoDialog" class="password-dialog account-dialog" data-account-dialog="info" aria-labelledby="accountInfoTitle">
  <header class="password-dialog-header account-dialog-header"><div><h2 id="accountInfoTitle" tabindex="-1">Thông tin tài khoản</h2><p>Thông tin đăng nhập và hồ sơ của riêng bạn.</p></div><button type="button" class="password-dialog-close" data-account-close aria-label="Đóng thông tin tài khoản"><span aria-hidden="true"></span></button></header>
  <div class="password-dialog-body"><dl class="account-info-list"><div><dt>Tên hiển thị</dt><dd data-account-field="name">—</dd></div><div><dt>Tên đăng nhập</dt><dd data-account-field="login">—</dd></div><div><dt>Email nhận OTP</dt><dd data-account-field="email">—</dd></div><div><dt>Biệt danh</dt><dd data-account-field="tag">—</dd></div></dl><div class="account-profile-link"><span>Liên kết hồ sơ</span><input data-account-profile-url readonly aria-label="Liên kết hồ sơ"><button type="button" class="password-secondary" data-account-copy>Sao chép liên kết</button></div><p class="account-dialog-status" data-account-copy-status role="status"></p><footer><button type="button" class="password-secondary" data-account-close>Đóng</button><a class="password-primary" href="/users/profile" data-account-profile>Xem hồ sơ</a></footer></div>
</dialog>
<dialog id="accountSessionsDialog" class="password-dialog account-dialog account-sessions-dialog" data-account-dialog="sessions" aria-labelledby="accountSessionsTitle">
  <header class="password-dialog-header account-dialog-header"><div><h2 id="accountSessionsTitle" tabindex="-1">Phiên đăng nhập</h2><p>Quản lý những thiết bị đang sử dụng tài khoản.</p></div><button type="button" class="password-dialog-close" data-account-close aria-label="Đóng danh sách thiết bị"><span aria-hidden="true"></span></button></header>
  <div class="password-dialog-body"><p class="account-dialog-status" data-session-status role="status"></p><div data-session-list-panel><div class="account-session-toolbar"><span data-session-count></span><button class="account-text-button" type="button" data-session-refresh>Làm mới</button></div><div class="account-session-list" data-session-list role="list" aria-label="Danh sách phiên đăng nhập"></div><button type="button" class="password-secondary" data-session-retry hidden>Thử tải lại</button><footer><button type="button" class="password-secondary" data-account-close>Đóng</button><button type="button" class="password-secondary account-danger-button" data-session-revoke-others disabled>Đăng xuất các phiên khác</button></footer></div><section class="account-session-confirm" data-session-confirm-panel hidden aria-labelledby="accountSessionConfirmTitle"><h3 id="accountSessionConfirmTitle">Đăng xuất phiên đăng nhập?</h3><p data-session-confirm-text></p><footer><button type="button" class="password-secondary" data-session-cancel>Hủy</button><button type="button" class="password-primary" data-session-confirm>Đăng xuất</button></footer></section></div>
</dialog>

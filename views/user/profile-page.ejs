<%
 const profile = data.profile, stats = data.stats;
 const avatar = profile.avatar, banner = profile.banner, tag = profile.tag;
 const profileMessage = typeof message === 'string' ? message : '';
 const profileLinks = profile.links;
 const hasEditor = Boolean(editorUser);
 const initialTab = data.query.tab;
 const location = [profile.city, profile.country].filter(Boolean).join(', ');
 // Previous canonical self address: '/users/profile'; all profiles now expose their named URL.
 const pageUrl = profile.url + (hasEditor && editOpen ? '/edit' : '');
 const metadata = { viewerId:data.viewerId, isSelf:data.isSelf, following:data.following, profile, stats, query:data.query, page:data.page, hasMore:data.hasMore };
%>
<section class="profile-page profile-page-v2" lang="en" data-profile-screen data-profile-meta="<%= JSON.stringify(metadata) %>" data-own-route="<%= ownRoute %>" data-profile-source="<%= ownRoute ? '/api/profiles' : '/api/profiles/' + profile.slug %>" data-profile-url="<%= pageUrl %>" data-session-state="ready" <% if(hasEditor) { %>data-profile-view data-profile-owner-id="<%= profile.id %>" data-edit-open="<%= editOpen ? 'true' : 'false' %>"<% } %>>
  <header class="profile-header"><img id="profileBanner" class="profile-cover" src="<%= banner %>" alt="" data-image-fallback="/images/bg_main.png"><span class="profile-cover-shade" aria-hidden="true"></span><div class="profile-identity"><img id="profileAvatar" class="profile-avatar" src="<%= avatar %>" alt="<%= profile.name %>" data-image-fallback="/images/auth/person-circle.svg"><div class="profile-info"><p class="profile-eyebrow">MEDIAHZ PROFILE</p><h1 id="profileFullName"><%= profile.name %></h1><p id="profileHeaderLocation" <%= location ? '' : 'hidden' %>><%= location %></p></div></div><% if(tag) { %><span id="profileTagLabel" class="profile-tag">#<%= tag.replace(/^#/, '') %></span><% } else if(hasEditor) { %><span id="profileTagLabel" class="profile-tag" hidden></span><% } %></header>
  <div class="profile-action-row"><dl class="profile-audience"><% for(const [key,label] of [['followers','Followers'],['following','Following'],['tracks','Tracks']]) { %><div><dd data-profile-stat="<%= key %>"><%= stats[key].toLocaleString('en-US') %></dd><dt><%= label %></dt></div><% } %></dl><div class="profile-actions"><button type="button" class="profile-button" data-profile-copy><span class="profile-icon profile-link-icon" aria-hidden="true"></span>Copy link</button><% if(hasEditor) { %><button id="editProfileButton" type="button" class="profile-edit-button" data-profile-private><span class="profile-icon profile-pencil" aria-hidden="true"></span>Edit Profile</button><% } else if(data.isSelf) { %><a class="profile-button" href="<%= profile.url %>/edit" data-profile-nav>Edit Profile</a><% } else { %><button type="button" class="profile-button profile-follow" data-profile-follow aria-pressed="<%= data.following %>"><%= data.following ? 'Following' : 'Follow' %></button><button type="button" class="profile-button" data-profile-message>Message</button><% } %></div></div>
  <input class="profile-share-output" data-profile-copy-output readonly aria-label="Profile link" value="" hidden><p id="profileSaveStatus" class="profile-save-status" role="status"></p>
  <div class="profile-tabs" role="tablist" aria-label="Profile sections"><% for(const [value,label] of [['tracks','Tracks'],['about','About']]) { %><button type="button" id="profileTab-<%= value %>" role="tab" data-profile-tab="<%= value %>" aria-selected="<%= initialTab===value %>" aria-controls="profilePanel-<%= value %>" tabindex="<%= initialTab===value ? 0 : -1 %>"><%= label %></button><% } %></div>
  <div class="profile-content-layout"><div class="profile-content-main"><section id="profilePanel-tracks" role="tabpanel" aria-labelledby="profileTab-tracks" <%= initialTab==='tracks' ? '' : 'hidden' %>><div class="profile-track-toolbar"><label class="profile-track-search"><span class="profile-sr-only">Search tracks by <%= profile.name %></span><input type="search" data-profile-search maxlength="100" placeholder="Search tracks" value="<%= data.query.q %>"></label><label>Sort by<select data-profile-sort><% for(const [value,label] of [['newest','Newest first'],['popular','Most played'],['title','Title A–Z']]) { %><option value="<%= value %>" <%= data.query.sort===value ? 'selected' : '' %>><%= label %></option><% } %></select></label><button type="button" class="profile-button" data-profile-refresh aria-label="Refresh tracks">↻</button></div><p class="profile-load-status" data-profile-status role="status" aria-live="polite"></p><div data-profile-tracks><% data.items.forEach(song=>{ %><%- include('_profile-track', {song,profile}) %><% }); %></div><div class="profile-track-empty" data-profile-empty <%= data.items.length ? 'hidden' : '' %>><span aria-hidden="true">♫</span><h2><%= data.query.q ? 'No matching tracks' : 'No public tracks yet' %></h2><p><%= data.query.q ? 'Try a different title or artist.' : data.isSelf ? 'Share your first track when you are ready.' : 'New uploads from this creator will appear here.' %></p><% if(canUpload) { %><a class="profile-button" href="/product" data-profile-nav data-profile-private>Upload a track</a><% } %></div><div class="profile-more"><button type="button" class="profile-button" data-profile-more <%= data.hasMore ? '' : 'hidden' %>>Load more</button><button type="button" class="profile-button" data-profile-retry hidden>Try again</button></div></section>
  <section id="profilePanel-about" class="profile-about-panel" role="tabpanel" aria-labelledby="profileTab-about" <%= initialTab==='about' ? '' : 'hidden' %>><h2>About <span data-profile-live-name><%= profile.name %></span></h2><p id="profileBio"><%= profile.bio || 'No bio yet.' %></p><p id="profileLocation" <%= location ? '' : 'hidden' %>><%= location %></p><h3>On the web</h3><ul id="profileLinks" class="profile-public-links"><% profileLinks.forEach(link=>{ %><li><a href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><span class="profile-icon profile-link-icon" aria-hidden="true"></span><%= link.label || new URL(link.url).hostname %></a></li><% }); %></ul><p class="profile-muted" data-profile-links-empty <%= profileLinks.length ? 'hidden' : '' %>>No links added yet.</p></section></div>
  <aside class="profile-sidebar" aria-label="Profile information"><section><h2>About</h2><p class="profile-side-bio" data-profile-live-bio><%= profile.bio || 'No bio yet.' %></p><p class="profile-muted" data-profile-live-location <%= location ? '' : 'hidden' %>><%= location %></p><button type="button" class="profile-text-button" data-profile-about>Read more</button></section><section><h2>Public tracks</h2><dl class="profile-public-stats"><% for(const [key,label] of [['plays','Plays'],['likes','Likes']]) { %><div><dd data-profile-stat="<%= key %>"><%= stats[key].toLocaleString('en-US') %></dd><dt><%= label %></dt></div><% } %></dl></section><% if(data.isSelf) { %><section data-profile-private><h2>Your space</h2><a href="/library" data-profile-nav>Open Library <span aria-hidden="true">↗</span></a><% if(canUpload) { %><a href="/product" data-profile-nav>Upload music <span aria-hidden="true">↗</span></a><% } %><a href="/users/settings" data-profile-nav>Account settings <span aria-hidden="true">↗</span></a></section><% } %><p class="profile-footnote">MediaHz · Music connects us</p></aside></div>
  <% if(hasEditor) { %><%- include('_profile-editor', {user:editorUser,avatar,banner,tag,profileMessage,profileLinks}) %><% } %>
</section>

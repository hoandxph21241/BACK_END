<article class="profile-track" data-profile-track="<%= song.id %>" data-profile-song="<%= JSON.stringify(song) %>">
  <button type="button" class="profile-track-cover" data-profile-play data-song-id="<%= song.id %>" aria-label="Play <%= song.name %>"><img src="<%= song.image %>" alt="" loading="lazy" decoding="async" data-profile-image-fallback="/images/chibi.gif"></button>
  <div class="profile-track-info"><p class="profile-track-artist"><%= song.artist && song.artist !== 'Unknown' ? song.artist : profile.name %></p><h3><a href="<%= song.url || '/home/song/' + song.id %>" data-profile-nav><%= song.name %></a></h3><div class="profile-track-meta"><% if(song.category?.name) { %><span class="profile-genre"><%= song.category.name %></span><% } %><% if(song.uploadDate && Number.isFinite(new Date(song.uploadDate).getTime())) { %><time datetime="<%= new Date(song.uploadDate).toISOString() %>"><%= new Date(song.uploadDate).toLocaleDateString('en-US', {month:'short',day:'numeric',year:'numeric'}) %></time><% } %><span data-profile-playing></span></div></div>
  <div class="profile-track-actions"><span class="profile-track-plays"><span aria-hidden="true">▷</span> <span data-song-plays="<%= song.id %>"><%= song.playCount.toLocaleString('en-US') %></span></span><button type="button" class="profile-button" data-song-like="<%= song.id %>" aria-label="Like" aria-pressed="false"><span class="song-like-icon" aria-hidden="true"></span><span data-song-likes="<%= song.id %>"><%= song.likeCount.toLocaleString('en-US') %></span></button><button type="button" class="profile-button" data-profile-queue data-song-id="<%= song.id %>" aria-label="Add <%= song.name %> to Next Up"><span class="profile-queue-icon" aria-hidden="true"></span><span>Next Up</span></button></div>
</article>

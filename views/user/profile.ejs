<!DOCTYPE html>
<html>

<head>
  <title>Rrofile-Info</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
    crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    integrity="sha384-k6RqeWeci5ZR/Lv4MR0sA0FfDOM8zE4dR8H3Xx7hPQ4d6G4He3bF1u8x1p/wi7" crossorigin="anonymous">
  <link rel="icon" href="/images/bg.png" type="image/x-icon">
  <link rel='stylesheet' href='/stylesheets/CSS_User/profile_user.css' />
</head>

<body>
  <% let mp3data%>
    <%- include('../inc/top.ejs')%>
      <div class="profile-banner">
        <img src="<%= user.imageAccount %>" class="profile-avatar" />
        <div class="profile-info">
          <h1>
            <%= user.fullName || 'Chưa có tên' %>
          </h1>
          <p>
            <%= user.gmail %>
          </p>
          <% if (user.bio) { %>
            <p class="bio">
              <%= user.bio %>
            </p>
            <% } %>
              <% if (user.grender) { %>
                <p class="gender">Giới tính: <%= user.grender %>
                </p>
                <% } %>
                  <a href="" class="edit-btn">Chỉnh sửa hồ sơ</a>
        </div>
      </div>
</body>

</html>
<!DOCTYPE html>
<html>

<head>
  <title>Cài đặt</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
    crossorigin="anonymous"></script>
  <link rel="icon" href="/images/bg.png" type="image/x-icon">
</head>

<body>
  <div class="container mt-5">
    <h1>⚙️ Cài đặt</h1>
    
    <div class="card mt-4">
      <div class="card-header">
        <h5>Cài đặt tài khoản</h5>
      </div>
      <div class="card-body">
        <form>
          <div class="mb-3">
            <label for="volume" class="form-label">Âm lượng:</label>
            <input type="range" class="form-range" id="volume" min="0" max="100" value="50">
          </div>
          
          <div class="mb-3">
            <label for="theme" class="form-label">Giao diện:</label>
            <select class="form-select" id="theme">
              <option value="dark">Tối</option>
              <option value="light">Sáng</option>
            </select>
          </div>

          <div class="mb-3">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="notifications" checked>
              <label class="form-check-label" for="notifications">
                Bật thông báo
              </label>
            </div>
          </div>

          <button type="submit" class="btn btn-primary">Lưu cài đặt</button>
        </form>
      </div>
    </div>
  </div>
</body>

</html>

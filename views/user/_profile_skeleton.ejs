<section class="profile-page profile-skeleton" data-profile-loading aria-label="Profile">
  <span class="profile-loading-status" role="status">Loading profile...</span>
  <header class="profile-header" aria-hidden="true" inert>
    <span class="profile-cover profile-skeleton-block profile-skeleton-banner"></span>
    <div class="profile-identity">
      <span class="profile-avatar profile-skeleton-block"></span>
      <div class="profile-info">
        <span class="profile-skeleton-block profile-skeleton-name"></span>
        <span class="profile-skeleton-block profile-skeleton-contact"></span>
      </div>
    </div>
    <span class="profile-edit-button profile-skeleton-block profile-skeleton-edit"></span>
    <span class="profile-tag profile-skeleton-block profile-skeleton-tag"></span>
  </header>
  <div class="profile-details" aria-hidden="true" inert>
    <span class="profile-skeleton-block profile-skeleton-heading"></span>
    <span class="profile-skeleton-block profile-skeleton-bio"></span>
    <span class="profile-skeleton-block profile-skeleton-bio profile-skeleton-bio-short"></span>
    <span class="profile-skeleton-block profile-skeleton-location"></span>
  </div>
</section>
